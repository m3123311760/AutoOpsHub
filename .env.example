# AutoOpsHub environment variable example.
# Copy values from this file into your process environment or local secret manager.
# Do not commit real secrets.

# Application
AUTOOPSHUB_HOME=
AUTOOPSHUB_REQUIRE_AUTH=true
AUTOOPSHUB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTOOPSHUB_TASK_EXEC_TIMEOUT_SECONDS=3600

# JWT authentication
# Required when AUTOOPSHUB_REQUIRE_AUTH=true. Use a long, random, private value.
AUTOOPSHUB_JWT_SECRET=replace-with-a-long-random-secret
AUTOOPSHUB_JWT_ALGORITHM=HS256
AUTOOPSHUB_JWT_EXPIRE_MINUTES=60

# MySQL
AUTOOPSHUB_MYSQL_HOST=127.0.0.1
AUTOOPSHUB_MYSQL_PORT=3306
AUTOOPSHUB_MYSQL_USER=autoopshub
AUTOOPSHUB_MYSQL_PASSWORD=autoopshub
AUTOOPSHUB_MYSQL_DATABASE=autoopshub

# MySQL container settings
AUTOOPSHUB_MYSQL_IMAGE_TAG=8.0
AUTOOPSHUB_MYSQL_ROOT_PASSWORD=root
AUTOOPSHUB_MYSQL_HEALTH_INTERVAL=10s
AUTOOPSHUB_MYSQL_HEALTH_TIMEOUT=5s
AUTOOPSHUB_MYSQL_HEALTH_RETRIES=10
AUTOOPSHUB_MYSQL_HEALTH_START_PERIOD=30s

# Redis log streaming
# Leave empty to disable Redis-backed log streaming.
AUTOOPSHUB_REDIS_URL=
AUTOOPSHUB_REDIS_LOG_PREFIX=autoopshub:logs:

# Redis container settings
AUTOOPSHUB_REDIS_IMAGE_TAG=7-alpine
AUTOOPSHUB_REDIS_PORT=6379
AUTOOPSHUB_REDIS_APPENDONLY=yes
AUTOOPSHUB_REDIS_HEALTH_INTERVAL=10s
AUTOOPSHUB_REDIS_HEALTH_TIMEOUT=5s
AUTOOPSHUB_REDIS_HEALTH_RETRIES=10

# Generic LDAP authentication
AUTOOPSHUB_LDAP_URI=ldap://127.0.0.1:389
AUTOOPSHUB_LDAP_BIND_DN_TEMPLATE=
AUTOOPSHUB_LDAP_BASE_DN=
AUTOOPSHUB_LDAP_CONNECT_TIMEOUT=5.0

# OpenLDAP container settings
AUTOOPSHUB_OPENLDAP_IMAGE_TAG=1.5.0
AUTOOPSHUB_LDAP_PORT=389
AUTOOPSHUB_LDAP_ORGANISATION=AutoOpsHub
AUTOOPSHUB_LDAP_DOMAIN=example.org
AUTOOPSHUB_LDAP_ADMIN_PASSWORD=admin

# Active Directory authentication
AUTOOPSHUB_AD_URI=ldap://ad.example.local:389
AUTOOPSHUB_AD_BIND_DN_TEMPLATE={username}@example.local
AUTOOPSHUB_AD_BASE_DN=
AUTOOPSHUB_AD_CONNECT_TIMEOUT=5.0

# Runtime command overrides
AUTOOPSHUB_TERRAFORM_BIN=terraform
AUTOOPSHUB_ANSIBLE_PLAYBOOK_BIN=ansible-playbook
AUTOOPSHUB_DEFAULT_SCRIPT_SHELL=/bin/sh

# API key behavior
AUTOOPSHUB_API_KEY_PREFIX_LEN=8

# Frontend container settings
AUTOOPSHUB_FRONTEND_NODE_IMAGE=node:24-alpine
AUTOOPSHUB_FRONTEND_IMAGE=autoopshub/frontend
AUTOOPSHUB_FRONTEND_TAG=latest
AUTOOPSHUB_FRONTEND_PORT=3000
AUTOOPSHUB_FRONTEND_CONTAINER_PORT=3000
AUTOOPSHUB_FRONTEND_HOSTNAME=0.0.0.0
AUTOOPSHUB_FRONTEND_HEALTH_INTERVAL=30s
AUTOOPSHUB_FRONTEND_HEALTH_TIMEOUT=5s
AUTOOPSHUB_FRONTEND_HEALTH_RETRIES=5
AUTOOPSHUB_FRONTEND_HEALTH_START_PERIOD=30s
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
